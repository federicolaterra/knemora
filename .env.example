# Product identity
KNEMORA_PRODUCT_NAME=Knemora
KNEMORA_PRODUCT_EDITION=community
KNEMORA_PRODUCT_DESCRIPTION=Open-source, local-first knowledge and agent platform with a native Second Brain graph, a portable Markdown wiki, and local AI inference.

# Application
KNEMORA_APP_ENV=development
KNEMORA_API_HOST=127.0.0.1
KNEMORA_API_PORT=8000
KNEMORA_WEB_ORIGIN=http://localhost:5173

# Embedded SQLite. KNEMORA_HOME defaults to ~/.knemora; the launcher writes the absolute URL.
# KNEMORA_HOME=/absolute/path/to/knemora-user-data
# KNEMORA_DATABASE_URL=sqlite+pysqlite:////absolute/path/to/.knemora/data/knemora.db

# Logging and local development identity
KNEMORA_LOG_LEVEL=INFO
KNEMORA_REQUEST_ID_HEADER=X-Request-ID
KNEMORA_DEFAULT_USER_EMAIL=local@knemora.invalid
KNEMORA_DEFAULT_USER_NAME=Local User

# Authentication is required by default. Set a unique 12+ character password before first start.
KNEMORA_AUTHENTICATION_REQUIRED=true
KNEMORA_BOOTSTRAP_ADMIN_EMAIL=admin@knemora.local
KNEMORA_BOOTSTRAP_ADMIN_NAME=Knemora Administrator
KNEMORA_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-local-password
KNEMORA_AUTH_SESSION_TTL_MINUTES=480
KNEMORA_AUTH_MAX_FAILED_ATTEMPTS=5
KNEMORA_AUTH_LOCKOUT_MINUTES=15
KNEMORA_LOGIN_RATE_LIMIT_PER_MINUTE=10
KNEMORA_MUTATION_RATE_LIMIT_PER_MINUTE=120
KNEMORA_TRUSTED_HOSTS=127.0.0.1,localhost

# Local llama.cpp. Model files must remain outside Git.
KNEMORA_LLM_BASE_URL=http://localhost:8080
KNEMORA_LLM_MODEL=qwen3-8b-q3-k-m
KNEMORA_LLM_QUANTIZATION=Q3_K_M (GSQ-refined K-Quant)
KNEMORA_LLM_TIMEOUT_SECONDS=180
# Optional explicit override. Precedence is setup --context-tokens, persisted per-model override,
# this value, curated/GGUF-derived profile, then conservative fallback. Invalid or unsafe explicit
# values fail before startup; Knemora never silently reduces an explicit override.
KNEMORA_LLM_CONTEXT_TOKENS=8192
KNEMORA_LLM_MAX_OUTPUT_TOKENS=1024
KNEMORA_LLM_ENABLE_THINKING=false
# The launcher keeps this false unless start/start-with-presets receives --yes-web-search.
KNEMORA_WEB_SEARCH_ENABLED=false
KNEMORA_WEB_SEARCH_TIMEOUT_SECONDS=8
KNEMORA_WEB_SEARCH_MAX_RESULTS=5
KNEMORA_UPDATE_CHECK_ENABLED=true
KNEMORA_MAX_USER_MESSAGE_CHARS=20000

# ./knemora resolves a verified application-managed llama-server. An advanced operator may set an
# absolute LLAMA_SERVER_BIN; a manual legacy source build may set LLAMA_CPP_DIR. Both are validated.
# Knemora never selects an arbitrary llama-server from PATH.
# Keep the GGUF outside this repository when possible.
# LLAMA_SERVER_BIN=/absolute/path/to/llama-server
# LLAMA_CPP_DIR=/absolute/path/to/llama.cpp
KNEMORA_MODEL_PATH=/absolute/path/to/model.gguf
KNEMORA_LLM_PORT=8080

# Demo metadata is set by ./knemora start-with-presets, not normal start.
KNEMORA_DEMO_MODE=false

# Local setup writes absolute paths beneath KNEMORA_HOME. Relative manual values resolve from the repository.
# KNEMORA_SOURCE_STORE_PATH=/absolute/path/to/.knemora/sources
# KNEMORA_KNOWLEDGE_PATH=/absolute/path/to/.knemora/wiki
KNEMORA_KNOWLEDGE_COMPILATION_VERSION=knemora-wiki/1
KNEMORA_KNOWLEDGE_COMPILATION_MAX_OUTPUT_TOKENS=2048
# Per structured-output attempt. Increase only for a measured slower healthy model; restart after
# editing .env. This changes waiting time, not context, token limits, or retry count.
KNEMORA_KNOWLEDGE_COMPILATION_TIMEOUT_SECONDS=300
KNEMORA_KNOWLEDGE_COMPILATION_BATCH_CHARS=12000
KNEMORA_WIKI_SEARCH_MAX_RESULTS=20
KNEMORA_WIKI_GRAPH_MAX_DEPTH=2
KNEMORA_WIKI_GRAPH_MAX_NODES=2000
KNEMORA_WIKI_GRAPH_MAX_EDGES=8000
KNEMORA_WIKI_GRAPH_SMALL_GRAPH_THRESHOLD=50
KNEMORA_WIKI_EVIDENCE_MAX_CHARS=12000
KNEMORA_SOURCE_REFERENCE_MAX_CHARS=8000
KNEMORA_DATASET_ANALYSIS_MAX_ROWS=250000
KNEMORA_DATASET_ANALYSIS_MAX_RESULT_ROWS=500
KNEMORA_MAX_UPLOAD_BYTES=26214400
KNEMORA_MAX_ARCHIVE_ENTRIES=10000
KNEMORA_MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600
KNEMORA_MAX_ARCHIVE_COMPRESSION_RATIO=100
